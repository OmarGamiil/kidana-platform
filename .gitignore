/backup/
/backups/
/dumps/

/database/backups/
/database/dumps/

/*.sql
/*.dump
/*.bak

/database/*.sql
/database/*.dump
/database/*.bak

*.sql.gz
*.dump.gz
*.bak.gz

# ==================================================
# Temporary Tests
# Permanent tests belong in the repository.
# Only temporary test files are ignored.
# ==================================================
/tests/Temporary/
/tests/_temporary/
/tests/tmp/

