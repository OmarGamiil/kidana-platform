# ==================================================
# Laravel Boost & AI Agents
# Keep shared project instructions tracked:
# .agents/, .claude/, .codex/, .cursor/,
# AGENTS.md, CLAUDE.md, boost.json and .mcp.json
# Ignore local-only settings and caches.
# ==================================================
/.agents/cache/
/.claude/cache/
/.codex/cache/
/.cursor/cache/
/.opencode/cache/

/.claude/settings.local.json
/.codex/settings.local.json
/.cursor/settings.local.json
/.opencode/settings.local.json
/.mcp.local.json

# ==================================================
