# ==================================================
# Kidana Platform - Git Ignore
# Laravel 13 + Vue 3 + Inertia.js 3 + TypeScript
# Tailwind CSS 4 + MySQL + Pest + Vite
# ==================================================

# ==================================================
# PHP & JavaScript Dependencies
# ==================================================
/vendor/
/node_modules/
composer.phar

# ==================================================
# Environment Files, Credentials & Secrets
# ==================================================
/.env
/.env.*
!/.env.example

/auth.json
/.envrc
/.direnv/

/secrets/
/credentials/
/private/

# Local authentication / registry credentials
/.npmrc.local
/.yarnrc.local
/.pnpmrc.local

# ==================================================
# Laravel Cache & Generated Runtime Files
# ==================================================
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

/bootstrap/ssr/

/storage/*.key
/storage/pail/
/storage/debugbar/
/storage/clockwork/

# ==================================================
# Laravel Storage
# ==================================================
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/
!/storage/app/private/

/storage/app/public/*
!/storage/app/public/.gitignore

/storage/app/private/*
!/storage/app/private/.gitignore

/storage/framework/cache/*
!/storage/framework/cache/.gitignore

/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore

/storage/framework/testing/*
!/storage/framework/testing/.gitignore

/storage/framework/views/*
!/storage/framework/views/.gitignore

/storage/logs/*
!/storage/logs/.gitignore

# ==================================================
# Frontend Build & Development Files
# ==================================================
/public/build/
/public/hot
/public/storage
/public/fonts-manifest.dev.json
/public/ssr-manifest.json

/.vite/
/.turbo/
/.parcel-cache/
/.eslintcache
/.stylelintcache
/.rollup.cache/

